apiVersion: v1
kind: Secret
metadata:
  name: bulletin-board-secret
  namespace: bulletin-board
type: Opaque
stringData:
  SPRING_DATASOURCE_USERNAME: "REPLACE_WITH_DATABASE_USERNAME"
  SPRING_DATASOURCE_PASSWORD: "REPLACE_WITH_DATABASE_PASSWORD"
  STORAGE_S3_ACCESSKEY: "REPLACE_WITH_APPLICATION_ACCESS_KEY"
  STORAGE_S3_SECRETKEY: "REPLACE_WITH_APPLICATION_SECRET_KEY"
  POSTGRES_CA_CERT: |
    -----BEGIN CERTIFICATE-----
    REPLACE_WITH_POSTGRES_CA_CERT
    -----END CERTIFICATE-----
